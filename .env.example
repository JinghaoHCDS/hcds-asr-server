# WSL GPU service. systemd loads this file; Python does not load it automatically.
# Keep mock for CPU-only development. Real deployment sets the qwen adapter.
ASR_ADAPTER=qwen
# Skill ZIP embeds this advertised server URL. Empty/loopback uses the download URL.
# Example for your deployment: http://YOUR_WINDOWS_LAN_IP:18080
ASR_PUBLIC_BASE_URL=
ASR_DEFAULT_MODEL=qwen3-asr-1.7b
ASR_API_TOKEN=
ASR_IDLE_UNLOAD_SECONDS=180
ASR_MAX_QUEUED_JOBS=20
ASR_MAX_UPLOAD_MB=512
ASR_JOB_RESULT_TTL_SECONDS=3600

# Enable only after the corresponding independent real-GPU smoke tests.
ASR_ENABLE_QWEN_ALIGNMENT=0
ASR_ENABLE_MOSS=0

# Agent-side MCP bridge. Host must supply these variables in its env configuration.
# Replace localhost with the Windows LAN address on remote clients.
ASR_MCP_BASE_URL=http://127.0.0.1:18080
# POSIX clients use ':'; native Windows uses ';'. Do not allow all of home or '/'.
ASR_MCP_ALLOWED_ROOTS=/path/to/audio
ASR_MCP_TOKEN=
ASR_MCP_MAX_FILE_MB=512
ASR_MCP_REQUEST_TIMEOUT_SECONDS=3600
# Local web workbench (same :18080). Create the first administrator with the local CLI.
ASR_WORKBENCH_ENABLED=1
ASR_WORKBENCH_DATA_DIR=data/workbench
ASR_WORKBENCH_RETENTION_DAYS=7
ASR_WORKBENCH_MAX_UPLOAD_BYTES=8589934592
ASR_WORKBENCH_USER_QUOTA_BYTES=17179869184
ASR_WORKBENCH_TOTAL_QUOTA_BYTES=68719476736

# Platform admission and diagnostics (single GPU FIFO; prefetch stays off by default).
ASR_RECEIVE_SLOTS=4
ASR_RECEIVE_TIMEOUT_SECONDS=30
ASR_MULTIPART_METADATA_BYTES=262144
ASR_PREPROCESSING_PREFETCH=0
# Optional private temporary root; default is a service-only directory under system temp.
# ASR_TEMP_DIR=/path/to/asr-temp
ASR_LOG_LEVEL=INFO
ASR_LOG_FORMAT=json
# ASR_LOG_DIR=/path/to/asr-logs
